@model MiniMart.Web.Models.Entities.User
@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i> Sửa thông tin: @Model.FullName (@@@Model.Username)</h5>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Username" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Tên đăng nhập (Username)</label>
                        <input value="@Model.Username" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label small fw-semibold">Vai trò & Phân quyền *</label>
                        <select asp-for="Role" class="form-select">
                            <option value="CASHIER">Thu ngân (Bán hàng)</option>
                            <option value="STORE_MANAGER">Quản lý cửa hàng</option>
                            <option value="WAREHOUSE_STAFF">Nhân viên kho</option>
                            <option value="ADMIN">Quản trị viên (Toàn quyền)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên *</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StoreId" class="form-label small fw-semibold">Chi nhánh làm việc</label>
                        <select asp-for="StoreId" class="form-select" asp-items="ViewBag.Stores">
                            <option value="">-- Tất cả chi nhánh (hoặc chưa gán) --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label small fw-semibold">Trạng thái</label>
                        <select asp-for="Status" class="form-select">
                            <option value="ACTIVE">Hoạt động</option>
                            <option value="DISABLED">Vô hiệu hóa</option>
                            <option value="LOCKED">Bị khóa tạm thời</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

