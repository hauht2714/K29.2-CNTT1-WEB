@model MiniMart.Web.Models.Entities.User
@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-person-plus me-2 text-primary"></i> Tạo tài khoản nhân viên mới</h5>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label small fw-semibold">Tên đăng nhập (Username) *</label>
                        <input asp-for="Username" class="form-control" placeholder="Ví dụ: hoa.nv" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mật khẩu khởi tạo *</label>
                        <input type="password" name="rawPassword" class="form-control" value="123456" />
                        <span class="text-muted" style="font-size: 11px;">Mặc định: 123456 (tối thiểu 6 ký tự)</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên đầy đủ *</label>
                    <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn Hoa" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="nhanvien@minimart.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label small fw-semibold">Vai trò & Phân quyền *</label>
                        <select asp-for="Role" class="form-select">
                            <option value="CASHIER">Thu ngân (Bán hàng)</option>
                            <option value="STORE_MANAGER">Quản lý cửa hàng</option>
                            <option value="WAREHOUSE_STAFF">Nhân viên kho</option>
                            <option value="ADMIN">Quản trị viên (Toàn quyền)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreId" class="form-label small fw-semibold">Chi nhánh làm việc</label>
                        <select asp-for="StoreId" class="form-select" asp-items="ViewBag.Stores">
                            <option value="">-- Tất cả chi nhánh (hoặc chưa gán) --</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

