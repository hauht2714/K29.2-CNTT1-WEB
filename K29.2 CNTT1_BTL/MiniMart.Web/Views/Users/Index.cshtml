@model IEnumerable<MiniMart.Web.Models.Entities.User>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
    var search = ViewBag.Search as string;
    var role = ViewBag.Role as string ?? "ALL";
    var storeId = ViewBag.StoreId as long?;
    var stores = ViewBag.Stores as IEnumerable<MiniMart.Web.Models.Entities.Store> ?? new List<MiniMart.Web.Models.Entities.Store>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-1">Danh sách nhân viên</h4>
        <p class="text-muted small mb-0">Quản trị tài khoản, phân quyền và gán chi nhánh làm việc</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3">
        <i class="bi bi-person-plus me-1"></i> Thêm nhân viên
    </a>
</div>

<div class="card-custom mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm theo username, tên, email..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select" onchange="this.form.submit()">
                <option value="ALL" selected="@(role == "ALL")">Tất cả vai trò</option>
                <option value="ADMIN" selected="@(role == "ADMIN")">Quản trị viên (Admin)</option>
                <option value="STORE_MANAGER" selected="@(role == "STORE_MANAGER")">Quản lý cửa hàng</option>
                <option value="CASHIER" selected="@(role == "CASHIER")">Thu ngân</option>
                <option value="WAREHOUSE_STAFF" selected="@(role == "WAREHOUSE_STAFF")">Nhân viên kho</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="storeId" class="form-select" onchange="this.form.submit()">
                <option value="">Tất cả chi nhánh</option>
                @foreach (var s in stores)
                {
                    <option value="@s.Id" selected="@(storeId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">Lọc</button>
        </div>
    </form>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted">
                    <th class="ps-3">Tài khoản</th>
                    <th>Họ và tên</th>
                    <th>Vai trò</th>
                    <th>Chi nhánh</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var u in Model)
                    {
                        var (roleLabel, roleBadge) = u.Role switch
                        {
                            "ADMIN" => ("Quản trị viên", "bg-primary-subtle text-primary"),
                            "STORE_MANAGER" => ("Quản lý", "bg-info-subtle text-info"),
                            "CASHIER" => ("Thu ngân", "bg-success-subtle text-success"),
                            "WAREHOUSE_STAFF" => ("Thủ kho", "bg-warning-subtle text-warning"),
                            _ => (u.Role, "bg-secondary-subtle text-secondary")
                        };

                        <tr>
                            <td class="ps-3 fw-bold text-dark">@@@u.Username</td>
                            <td class="fw-semibold">@u.FullName</td>
                            <td>
                                <span class="badge @roleBadge rounded-pill px-2 py-1">@roleLabel</span>
                            </td>
                            <td class="small text-muted">
                                @(u.Store?.Name ?? "Tất cả chi nhánh")
                            </td>
                            <td class="small text-muted">@(u.Email ?? "---")</td>
                            <td>
                                @if (u.Status == "ACTIVE")
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Hoạt động</span>
                                }
                                else if (u.Status == "LOCKED")
                                {
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1">Bị khóa tạm</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">Vô hiệu</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary rounded-2 me-1" title="Sửa thông tin">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 me-1" data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id" title="Đặt lại mật khẩu">
                                    <i class="bi bi-key"></i>
                                </button>

                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái tài khoản @u.Username?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-2" title="Khóa/Mở khóa">
                                        <i class="bi bi-lock"></i>
                                    </button>
                                </form>

                                <!-- Modal Reset Password -->
                                <div class="modal fade" id="resetModal-@u.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content rounded-4 border-0">
                                            <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h6 class="modal-title fw-bold">Đặt lại mật khẩu cho: @u.Username</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Nhập mật khẩu mới (để trống sẽ tự đặt thành mặc định: <strong>123456</strong>):</p>
                                                    <input type="text" name="newPassword" class="form-control" placeholder="123456" />
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-sm btn-primary">Xác nhận</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            Không tìm thấy nhân viên nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

