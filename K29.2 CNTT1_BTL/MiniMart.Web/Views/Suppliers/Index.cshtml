@model IEnumerable<MiniMart.Web.Models.Entities.Supplier>
@{
    ViewData["Title"] = "Nhà cung cấp";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-1">Đối tác nhà cung cấp</h4>
        <p class="text-muted small mb-0">Quản lý nguồn hàng và thông tin liên hệ nhà cung ứng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3">
        <i class="bi bi-plus-lg me-1"></i> Thêm nhà cung cấp
    </a>
</div>

<div class="card-custom mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm theo tên, mã NCC, SĐT, người liên hệ..." />
            </div>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-secondary px-4">Tìm kiếm</button>
        </div>
    </form>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted">
                    <th class="ps-3">Mã NCC</th>
                    <th>Tên nhà cung cấp</th>
                    <th>Người liên hệ</th>
                    <th>Điện thoại / Email</th>
                    <th>Mã số thuế</th>
                    <th>Địa chỉ</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">@s.SupplierCode</td>
                            <td class="fw-semibold text-dark">@s.Name</td>
                            <td class="small">@(s.ContactPerson ?? "---")</td>
                            <td class="small">
                                <div><i class="bi bi-telephone text-muted me-1"></i>@(s.Phone ?? "---")</div>
                                @if (!string.IsNullOrEmpty(s.Email))
                                {
                                    <div class="text-muted"><i class="bi bi-envelope me-1"></i>@s.Email</div>
                                }
                            </td>
                            <td class="small text-muted">@(s.TaxCode ?? "---")</td>
                            <td class="small text-muted" style="max-width: 200px;">@(s.Address ?? "---")</td>
                            <td>
                                @if (s.Status == "ACTIVE")
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">Ngừng</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary rounded-2 me-1" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái NCC này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-2" title="Đổi trạng thái">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-building fs-1 d-block mb-2"></i>
                            Không tìm thấy nhà cung cấp nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

