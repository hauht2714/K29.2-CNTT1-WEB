@model MiniMart.Web.Models.Entities.Supplier
@{
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i> Sửa thông tin: @Model.Name</h5>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="SupplierCode" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mã nhà cung cấp</label>
                        <input value="@Model.SupplierCode" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TaxCode" class="form-label small fw-semibold">Mã số thuế</label>
                        <input asp-for="TaxCode" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold">Tên công ty / Nhà cung cấp *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label small fw-semibold">Người liên hệ</label>
                        <input asp-for="ContactPerson" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label small fw-semibold">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="ACTIVE">Hoạt động</option>
                        <option value="INACTIVE">Ngừng hợp tác</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

