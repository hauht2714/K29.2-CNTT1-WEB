@model MiniMart.Web.Models.Entities.Supplier
@{
    ViewData["Title"] = "Thêm nhà cung cấp mới";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-building me-2 text-primary"></i> Thêm đối tác nhà cung cấp</h5>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SupplierCode" class="form-label small fw-semibold">Mã nhà cung cấp *</label>
                        <input asp-for="SupplierCode" class="form-control" />
                        <span asp-validation-for="SupplierCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TaxCode" class="form-label small fw-semibold">Mã số thuế</label>
                        <input asp-for="TaxCode" class="form-control" placeholder="03xxxxxxx" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold">Tên công ty / Nhà cung cấp *</label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Công ty TNHH Thực Phẩm Á Châu" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label small fw-semibold">Người liên hệ</label>
                        <input asp-for="ContactPerson" class="form-control" placeholder="Họ tên người đại diện" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" placeholder="09xxxxxxx" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="supplier@example.com" />
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ kho / trụ sở</label>
                    <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, khu công nghiệp..." />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Lưu nhà cung cấp</button>
                </div>
            </form>
        </div>
    </div>
</div>

