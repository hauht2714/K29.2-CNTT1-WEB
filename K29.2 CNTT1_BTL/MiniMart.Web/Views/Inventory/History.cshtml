@model List<MiniMart.Web.Models.Entities.InventoryTransaction>
@{
    ViewData["Title"] = "Nhật ký biến động kho";
    var isAdmin = User.IsInRole("ADMIN");
    var stores = ViewBag.Stores as List<MiniMart.Web.Models.Entities.Store> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Quay lại tồn kho">
            <i class="bi bi-arrow-left fs-6"></i>
        </a>
        <div>
            <h2 class="h4 mb-0 text-slate-900 fw-bold">Nhật ký biến động kho (Sổ kho)</h2>
            <p class="text-muted small mb-0">Theo dõi toàn bộ lịch sử xuất, nhập, bán hàng, kiểm kê và chuyển kho</p>
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-boxes me-1"></i> Bảng tồn kho
        </a>
    </div>
</div>

<!-- Bộ lọc nhật ký kho -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            @if (isAdmin)
            {
                <div class="col-md-3">
                    <select name="storeId" class="form-select bg-light">
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id" selected="@(s.Id == ViewBag.SelectedStoreId)">@s.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <select name="type" class="form-select bg-light">
                    <option value="ALL" selected="@(ViewBag.SelectedType == "ALL")">Tất cả loại giao dịch</option>
                    <option value="SALE" selected="@(ViewBag.SelectedType == "SALE")">Bán hàng (Xuất kho)</option>
                    <option value="IMPORT" selected="@(ViewBag.SelectedType == "IMPORT")">Nhập hàng từ NCC</option>
                    <option value="RETURN" selected="@(ViewBag.SelectedType == "RETURN")">Khách trả / Hủy đơn</option>
                    <option value="ADJUSTMENT" selected="@(ViewBag.SelectedType == "ADJUSTMENT")">Kiểm kê cân chỉnh</option>
                    <option value="TRANSFER_OUT" selected="@(ViewBag.SelectedType == "TRANSFER_OUT")">Xuất chuyển kho</option>
                    <option value="TRANSFER_IN" selected="@(ViewBag.SelectedType == "TRANSFER_IN")">Nhận chuyển kho</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc nhật ký
                </button>
                <a asp-action="History" class="btn btn-outline-secondary" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng nhật ký -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Thời gian</th>
                    <th>Sản phẩm</th>
                    <th>Loại giao dịch</th>
                    <th class="text-center">Biến động</th>
                    <th>Ghi chú / Tham chiếu</th>
                    <th class="pe-4">Chi nhánh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-text display-4 d-block mb-2 text-slate-300"></i>
                            Không có bản ghi nhật ký kho nào khớp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in Model)
                    {
                        var isPlus = (t.Quantity ?? 0) > 0;
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium">@t.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted" style="font-size: 11px;">@t.CreatedAt.ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                @if (t.Product != null)
                                {
                                    <div class="fw-bold text-slate-900">@t.Product.Name</div>
                                    <div class="small text-muted" style="font-size: 11px;">Mã: @t.Product.ProductCode</div>
                                }
                                else
                                {
                                    <span class="text-muted">ID: #@t.ProductId</span>
                                }
                            </td>
                            <td>
                                @switch (t.Type)
                                {
                                    case "SALE":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-cart me-1"></i> Bán lẻ
                                        </span>
                                        break;
                                    case "IMPORT":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-box-arrow-in-down me-1"></i> Nhập kho
                                        </span>
                                        break;
                                    case "RETURN":
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-arrow-return-left me-1"></i> Trả hàng / Hủy HĐ
                                        </span>
                                        break;
                                    case "ADJUSTMENT":
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            <i class="bi bi-sliders me-1"></i> Kiểm kê
                                        </span>
                                        break;
                                    case "TRANSFER_OUT":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Xuất chuyển
                                        </span>
                                        break;
                                    case "TRANSFER_IN":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-box-arrow-in-down-left me-1"></i> Nhận chuyển
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@t.Type</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <span class="fw-bold fs-6 @(isPlus ? "text-success" : "text-danger")">
                                    @(isPlus ? "+" : "")@(t.Quantity ?? 0)
                                </span>
                            </td>
                            <td>
                                <div class="small text-slate-800">@(t.Note ?? "Không có ghi chú")</div>
                                @if (t.ReferenceId.HasValue)
                                {
                                    <div class="small text-muted" style="font-size: 11px;">Mã tham chiếu: #@t.ReferenceId</div>
                                }
                            </td>
                            <td class="pe-4">
                                <span class="badge bg-light text-secondary border">@(t.Store?.Name ?? "N/A")</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng số @ViewBag.TotalRecords bản ghi)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="History" 
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-storeId="@ViewBag.SelectedStoreId"
                           asp-route-type="@ViewBag.SelectedType">Trước</a>
                    </li>
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="History" 
                               asp-route-page="@p"
                               asp-route-storeId="@ViewBag.SelectedStoreId"
                               asp-route-type="@ViewBag.SelectedType">@p</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="History" 
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-storeId="@ViewBag.SelectedStoreId"
                           asp-route-type="@ViewBag.SelectedType">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

