@model MiniMart.Web.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 mt-3">
            <div class="text-center mb-4">
                <div class="avatar-lg bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; font-size: 24px;">
                    <i class="bi bi-key"></i>
                </div>
                <h4 class="fw-bold mb-1">Đổi mật khẩu tài khoản</h4>
                <p class="text-muted small">Cập nhật mật khẩu mới để bảo mật thông tin</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small fw-semibold">Mật khẩu hiện tại</label>
                    <input asp-for="CurrentPassword" class="form-control rounded-3" placeholder="Nhập mật khẩu hiện tại" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="form-control rounded-3" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-3 w-50">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-3 w-50">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

