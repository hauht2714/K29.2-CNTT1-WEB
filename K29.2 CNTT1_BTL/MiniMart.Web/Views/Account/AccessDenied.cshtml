@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center text-center my-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="text-danger mb-3" style="font-size: 64px;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold text-danger mb-2">Truy Cập Bị Từ Chối</h3>
            <p class="text-muted mb-4">
                Bạn không có quyền hạn (vai trò) phù hợp để truy cập vào phân hệ này.<br />
                Vui lòng liên hệ Quản trị viên hệ thống nếu bạn nghĩ đây là sự nhầm lẫn.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-3 px-4">
                    <i class="bi bi-house-door me-1"></i> Quay về Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

