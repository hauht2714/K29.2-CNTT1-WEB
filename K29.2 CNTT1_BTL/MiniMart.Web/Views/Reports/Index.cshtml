@model MiniMart.Web.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Báo cáo doanh thu & Lợi nhuận";
    var stores = ViewBag.Stores as List<MiniMart.Web.Models.Entities.Store> ?? new();
    var isAdmin = User.IsInRole("ADMIN");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 text-slate-900 fw-bold">Báo cáo doanh thu & Hiệu quả kinh doanh</h2>
        <p class="text-muted small mb-0">Phân tích chuyên sâu doanh số, lợi nhuận gộp ước tính, sản phẩm chủ lực và hiệu suất nhân sự</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" 
           asp-route-timeRange="@Model.TimeRange"
           asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
           asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
           asp-route-storeId="@Model.SelectedStoreId"
           class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất báo cáo (CSV)
        </a>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In báo cáo
        </button>
    </div>
</div>

<!-- Bộ lọc thời gian & Chi nhánh -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            @if (isAdmin)
            {
                <div class="col-md-3">
                    <select name="storeId" class="form-select bg-light">
                        <option value="0">Tất cả chi nhánh</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id" selected="@(s.Id == Model.SelectedStoreId)">@s.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <select name="timeRange" id="timeRangeSelect" class="form-select bg-light" onchange="toggleCustomDates()">
                    <option value="today" selected="@(Model.TimeRange == "today")">Hôm nay</option>
                    <option value="yesterday" selected="@(Model.TimeRange == "yesterday")">Hôm qua</option>
                    <option value="7days" selected="@(Model.TimeRange == "7days")">7 ngày gần đây</option>
                    <option value="30days" selected="@(Model.TimeRange == "30days")">30 ngày gần đây</option>
                    <option value="thisMonth" selected="@(Model.TimeRange == "thisMonth")">Tháng này</option>
                    <option value="lastMonth" selected="@(Model.TimeRange == "lastMonth")">Tháng trước</option>
                    <option value="custom" selected="@(Model.TimeRange == "custom")">Tùy chọn khoảng ngày...</option>
                </select>
            </div>
            <div class="col-md-2 custom-date-col @(Model.TimeRange == "custom" ? "" : "d-none")">
                <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control bg-light" placeholder="Từ ngày" />
            </div>
            <div class="col-md-2 custom-date-col @(Model.TimeRange == "custom" ? "" : "d-none")">
                <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control bg-light" placeholder="Đến ngày" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 4 Thẻ KPI Tài Chính -->
<div class="row g-3 mb-4">
    <!-- Doanh thu bán hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng doanh thu thực tế</div>
                    <div class="stat-value text-primary">@Model.TotalRevenue.ToString("N0")đ</div>
                    <div class="small text-muted">Giảm trừ/Điểm: @Model.TotalDiscounts.ToString("N0")đ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ước tính Lợi nhuận gộp -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <div class="stat-label">Lợi nhuận gộp ước tính</div>
                    <div class="stat-value text-success">@Model.GrossProfit.ToString("N0")đ</div>
                    <div class="small text-muted">Biên LN: <strong class="text-success">@Model.ProfitMargin.ToString("F1")%</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ước tính Giá vốn hàng bán (COGS) -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-warning-subtle text-warning me-3">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="stat-label">Giá vốn xuất kho (COGS)</div>
                    <div class="stat-value text-warning">@Model.EstimatedCost.ToString("N0")đ</div>
                    <div class="small text-muted">Dựa trên giá nhập theo lô FIFO</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Đơn hàng & Giá trị trung bình (AOV) -->
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng số hóa đơn / AOV</div>
                    <div class="stat-value text-dark">@Model.TotalInvoices <span class="fs-6 fw-normal text-muted">đơn</span></div>
                    <div class="small text-muted">TB: <strong class="text-info">@Model.AverageOrderValue.ToString("N0")đ</strong>/đơn</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hàng Biểu đồ Chart.js -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ Doanh thu & Lợi nhuận -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-bar-chart-line text-primary me-2"></i>Biến thiên Doanh thu & Lợi nhuận gộp theo kỳ
                </h6>
                <span class="badge bg-light text-muted border">Kỳ báo cáo</span>
            </div>
            <div class="card-body">
                <div style="height: 300px; position: relative;">
                    <canvas id="revenueProfitChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ Tỷ trọng Danh mục sản phẩm -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Cơ cấu doanh thu theo Danh mục
                </h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="width: 220px; height: 220px; position: relative;" class="mb-3">
                    <canvas id="categoryShareChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng Chi tiết: Top 10 Bán chạy & Doanh số Thu ngân -->
<div class="row g-4">
    <!-- Top 10 Sản phẩm bán chạy nhất -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-trophy text-warning me-2"></i>Top 10 sản phẩm đạt doanh số cao nhất
                </h6>
            </div>
            <div class="card-body p-0">
                @if (Model.TopProducts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>Sản phẩm</th>
                                    <th>Danh mục</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-3">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopProducts.Count; i++)
                                {
                                    var p = Model.TopProducts[i];
                                    <tr>
                                        <td class="text-center">
                                            @if (i == 0) { <span class="badge bg-warning text-dark">1</span> }
                                            else if (i == 1) { <span class="badge bg-secondary text-white">2</span> }
                                            else if (i == 2) { <span class="badge bg-danger text-white">3</span> }
                                            else { <span class="badge bg-light text-muted border">@(i + 1)</span> }
                                        </td>
                                        <td>
                                            <div class="fw-bold text-slate-900">@p.ProductName</div>
                                            <div class="text-muted" style="font-size: 11px;">Mã: @p.ProductCode</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@p.CategoryName</span>
                                        </td>
                                        <td class="text-center fw-bold">
                                            @p.QuantitySold
                                        </td>
                                        <td class="text-end pe-3 fw-bold text-primary">
                                            @p.TotalRevenue.ToString("N0")đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                        Không có dữ liệu trong khoảng thời gian đã chọn.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Hiệu suất doanh số theo Thu ngân / Nhân viên -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-person-badge text-primary me-2"></i>Doanh số theo nhân viên thu ngân
                </h6>
            </div>
            <div class="card-body p-0">
                @if (Model.CashierSales.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Thu ngân</th>
                                    <th class="text-center">Số hóa đơn</th>
                                    <th class="text-end pe-3">Tổng doanh số</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CashierSales)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-slate-900">@c.CashierName</div>
                                            <div class="text-muted" style="font-size: 11px;">@@@c.Username</div>
                                        </td>
                                        <td class="text-center fw-medium">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @c.InvoicesCount đơn
                                            </span>
                                        </td>
                                        <td class="text-end pe-3 fw-bold text-success">
                                            @c.TotalAmount.ToString("N0")đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                        Chưa có giao dịch của nhân viên nào.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleCustomDates() {
        const val = document.getElementById('timeRangeSelect').value;
        const customCols = document.querySelectorAll('.custom-date-col');
        customCols.forEach(c => {
            if (val === 'custom') c.classList.remove('d-none');
            else c.classList.add('d-none');
        });
    }

    // 1. Biểu đồ Combo Doanh thu (Bar) & Lợi nhuận (Line)
    const ctxRP = document.getElementById('revenueProfitChart').getContext('2d');
    const chartDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDates));
    const chartRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartRevenues));
    const chartProfits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartProfits));

    new Chart(ctxRP, {
        type: 'bar',
        data: {
            labels: chartDates,
            datasets: [
                {
                    type: 'bar',
                    label: 'Doanh thu',
                    data: chartRevenues,
                    backgroundColor: 'rgba(37, 99, 235, 0.75)',
                    borderColor: '#2563eb',
                    borderWidth: 1,
                    borderRadius: 4
                },
                {
                    type: 'line',
                    label: 'Lợi nhuận gộp',
                    data: chartProfits,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 2.5,
                    fill: false,
                    tension: 0.3,
                    pointBackgroundColor: '#10b981',
                    pointRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top', labels: { boxWidth: 12 } },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return ` ${context.dataset.label}: ${Number(context.parsed.y).toLocaleString()} đ`;
                        }
                    }
                }
            },
            scales: {
                y: {
                    ticks: {
                        callback: function (val) {
                            if (val >= 1000000) return (val / 1000000) + 'Tr';
                            if (val >= 1000) return (val / 1000) + 'k';
                            return val;
                        }
                    },
                    grid: { color: '#f1f5f9' }
                },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Biểu đồ Tròn Doanh thu theo Danh mục
    const ctxCat = document.getElementById('categoryShareChart').getContext('2d');
    const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels));
    const catRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues));

    const palette = ['#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#64748b'];

    new Chart(ctxCat, {
        type: 'doughnut',
        data: {
            labels: catLabels.length > 0 ? catLabels : ['Chưa có'],
            datasets: [{
                data: catRevenues.length > 0 ? catRevenues : [1],
                backgroundColor: catRevenues.length > 0 ? palette.slice(0, catLabels.length) : ['#e2e8f0'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            if (catRevenues.length === 0) return ' Chưa có dữ liệu';
                            const val = context.parsed;
                            return ` ${context.label}: ${Number(val).toLocaleString()} đ`;
                        }
                    }
                }
            },
            cutout: '65%'
        }
    });
</script>
}

