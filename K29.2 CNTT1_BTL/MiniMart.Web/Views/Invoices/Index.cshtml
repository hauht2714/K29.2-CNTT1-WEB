@model List<MiniMart.Web.Models.Entities.Invoice>
@{
    ViewData["Title"] = "Quản lý hóa đơn";
    var canCancel = User.IsInRole("ADMIN") || User.IsInRole("STORE_MANAGER");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 text-slate-900 fw-bold">Danh sách hóa đơn</h2>
        <p class="text-muted small mb-0">Theo dõi toàn bộ lịch sử bán hàng và thanh toán tại cửa hàng</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" 
           asp-route-keyword="@ViewBag.Keyword" 
           asp-route-status="@ViewBag.Status" 
           asp-route-paymentMethod="@ViewBag.PaymentMethod" 
           asp-route-timeRange="@ViewBag.TimeRange" 
           asp-route-fromDate="@ViewBag.FromDate" 
           asp-route-toDate="@ViewBag.ToDate" 
           class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel (CSV)
        </a>
        <a asp-controller="Pos" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-cart3 me-1"></i> Bán hàng mới (POS)
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng hóa đơn</div>
                    <div class="stat-value">@ViewBag.TotalCount</div>
                    <div class="small text-muted">Hợp lệ: <span class="text-success fw-medium">@ViewBag.CompletedCount</span> · Hủy: <span class="text-danger fw-medium">@ViewBag.CancelledCount</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <div class="stat-label">Doanh thu hợp lệ</div>
                    <div class="stat-value text-success">@(((decimal)(ViewBag.TotalRevenue ?? 0)).ToString("N0"))đ</div>
                    <div class="small text-muted">Từ các đơn hoàn thành</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-warning-subtle text-warning me-3">
                    <i class="bi bi-tag"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng chiết khấu/điểm</div>
                    <div class="stat-value text-warning">@(((decimal)(ViewBag.TotalDiscounts ?? 0)).ToString("N0"))đ</div>
                    <div class="small text-muted">Đã giảm trừ cho khách</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-danger-subtle text-danger me-3">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <div class="stat-label">Đơn đã hủy</div>
                    <div class="stat-value text-danger">@ViewBag.CancelledCount</div>
                    <div class="small text-muted">Đã hoàn hàng về kho</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control bg-light border-start-0" placeholder="Mã HĐ, Tên KH, SĐT..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select bg-light">
                    <option value="ALL" selected="@(ViewBag.Status == "ALL" || string.IsNullOrEmpty(ViewBag.Status))">Tất cả trạng thái</option>
                    <option value="COMPLETED" selected="@(ViewBag.Status == "COMPLETED")">Hoàn thành</option>
                    <option value="CANCELLED" selected="@(ViewBag.Status == "CANCELLED")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="paymentMethod" class="form-select bg-light">
                    <option value="ALL" selected="@(ViewBag.PaymentMethod == "ALL" || string.IsNullOrEmpty(ViewBag.PaymentMethod))">Tất cả thanh toán</option>
                    <option value="CASH" selected="@(ViewBag.PaymentMethod == "CASH")">Tiền mặt</option>
                    <option value="CARD" selected="@(ViewBag.PaymentMethod == "CARD")">Thẻ</option>
                    <option value="TRANSFER" selected="@(ViewBag.PaymentMethod == "TRANSFER")">Chuyển khoản</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="timeRange" class="form-select bg-light">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.TimeRange))">Toàn bộ thời gian</option>
                    <option value="today" selected="@(ViewBag.TimeRange == "today")">Hôm nay</option>
                    <option value="yesterday" selected="@(ViewBag.TimeRange == "yesterday")">Hôm qua</option>
                    <option value="7days" selected="@(ViewBag.TimeRange == "7days")">7 ngày gần đây</option>
                    <option value="30days" selected="@(ViewBag.TimeRange == "30days")">30 ngày gần đây</option>
                    <option value="thisMonth" selected="@(ViewBag.TimeRange == "thisMonth")">Tháng này</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách hóa đơn -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã hóa đơn</th>
                    <th>Thời gian</th>
                    <th>Khách hàng</th>
                    <th>Thu ngân</th>
                    <th>Hình thức</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt display-4 d-block mb-2 text-slate-300"></i>
                            Không có hóa đơn nào khớp với tiêu chí tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-primary text-decoration-none">
                                    #@item.InvoiceCode
                                </a>
                                <div class="small text-muted" style="font-size: 11.5px;">@item.Store?.Name</div>
                            </td>
                            <td>
                                <div>@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted" style="font-size: 11.5px;">@item.CreatedAt.ToString("HH:mm:ss")</div>
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <div class="fw-medium text-slate-800">@item.Customer.FullName</div>
                                    <div class="small text-muted" style="font-size: 11.5px;">@item.Customer.Phone</div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Khách lẻ</span>
                                }
                            </td>
                            <td>
                                <div class="small fw-medium">@item.Cashier?.FullName</div>
                                <div class="text-muted" style="font-size: 11px;">@@@item.Cashier?.Username</div>
                            </td>
                            <td>
                                @if (item.PaymentMethod == "CASH")
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-cash me-1 text-success"></i> Tiền mặt</span>
                                }
                                else if (item.PaymentMethod == "CARD")
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1 text-primary"></i> Thẻ</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-qr-code me-1 text-info"></i> QR Chuyển khoản</span>
                                }
                            </td>
                            <td class="text-end">
                                <span class="fw-bold text-slate-900">@item.TotalAmount.ToString("N0")đ</span>
                                @if (item.DiscountAmount > 0 || item.PointsDiscount > 0)
                                {
                                    <div class="text-success small" style="font-size: 11px;">
                                        -@((item.DiscountAmount + item.PointsDiscount).ToString("N0"))đ
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "COMPLETED")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i> Hoàn thành
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@item.CancelReason">
                                        <i class="bi bi-x-circle me-1"></i> Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary" onclick="printReceiptDirect(@item.Id)" title="In lại hóa đơn">
                                        <i class="bi bi-printer"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng số @ViewBag.TotalCount hóa đơn)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-keyword="@ViewBag.Keyword"
                           asp-route-status="@ViewBag.Status"
                           asp-route-paymentMethod="@ViewBag.PaymentMethod"
                           asp-route-timeRange="@ViewBag.TimeRange">Trước</a>
                    </li>
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p"
                               asp-route-keyword="@ViewBag.Keyword"
                               asp-route-status="@ViewBag.Status"
                               asp-route-paymentMethod="@ViewBag.PaymentMethod"
                               asp-route-timeRange="@ViewBag.TimeRange">@p</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-keyword="@ViewBag.Keyword"
                           asp-route-status="@ViewBag.Status"
                           asp-route-paymentMethod="@ViewBag.PaymentMethod"
                           asp-route-timeRange="@ViewBag.TimeRange">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal xem trước và in hóa đơn nhiệt -->
<div class="modal fade" id="printModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-printer me-2"></i>In hóa đơn</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="receiptPreview" class="p-3 bg-light rounded border text-monospace" style="font-family: 'Courier New', Courier, monospace; font-size: 13px;">
                    <!-- Nội dung hóa đơn nạp bằng JS -->
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In hóa đơn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function printReceiptDirect(invoiceId) {
            try {
                const res = await fetch(`/Invoices/GetReceiptData?id=${invoiceId}`);
                const data = await res.json();
                if (!data.success) {
                    alert(data.message || 'Lỗi khi tải dữ liệu hóa đơn.');
                    return;
                }

                const r = data.receipt;
                let itemsHtml = '';
                r.items.forEach(it => {
                    itemsHtml += `
                        <div class="d-flex justify-content-between mb-1">
                            <div>${it.productName} <br><span class="text-muted small">${it.quantity} x ${it.unitPrice.toLocaleString('vi-VN')}đ</span></div>
                            <div class="fw-bold">${it.subtotal.toLocaleString('vi-VN')}đ</div>
                        </div>
                    `;
                });

                const html = `
                    <div class="text-center mb-3">
                        <div class="fw-bold fs-6">${r.storeName}</div>
                        <div class="small">${r.storeAddress}</div>
                        <div class="small">SĐT: ${r.storePhone}</div>
                        <hr class="my-2 border-dashed">
                        <div class="fw-bold">HÓA ĐƠN BÁN HÀNG</div>
                        <div class="small">Mã: #${r.invoiceCode}</div>
                        <div class="small">${r.createdAt}</div>
                    </div>
                    <div class="small mb-2">
                        <div>Thu ngân: <strong>${r.cashierName}</strong></div>
                        <div>Khách hàng: <strong>${r.customerName}</strong> ${r.customerPhone ? `(${r.customerPhone})` : ''}</div>
                    </div>
                    <hr class="my-2 border-dashed">
                    ${itemsHtml}
                    <hr class="my-2 border-dashed">
                    <div class="d-flex justify-content-between small"><span>Tạm tính:</span><span>${r.subtotal.toLocaleString('vi-VN')}đ</span></div>
                    ${r.discountAmount > 0 ? `<div class="d-flex justify-content-between small text-success"><span>Giảm giá:</span><span>-${r.discountAmount.toLocaleString('vi-VN')}đ</span></div>` : ''}
                    ${r.pointsDiscount > 0 ? `<div class="d-flex justify-content-between small text-success"><span>Điểm thưởng:</span><span>-${r.pointsDiscount.toLocaleString('vi-VN')}đ</span></div>` : ''}
                    <div class="d-flex justify-content-between fw-bold fs-6 mt-1 border-top pt-1">
                        <span>TỔNG TIỀN:</span>
                        <span>${r.totalAmount.toLocaleString('vi-VN')}đ</span>
                    </div>
                    <div class="d-flex justify-content-between small mt-1"><span>Hình thức:</span><span>${r.paymentMethod}</span></div>
                    <div class="d-flex justify-content-between small"><span>Khách đưa:</span><span>${r.cashReceived.toLocaleString('vi-VN')}đ</span></div>
                    <div class="d-flex justify-content-between small"><span>Tiền thừa:</span><span>${r.cashChange.toLocaleString('vi-VN')}đ</span></div>
                    <hr class="my-2 border-dashed">
                    <div class="text-center small text-muted">
                        <div>Cảm ơn quý khách và hẹn gặp lại!</div>
                        <div>Hotline hỗ trợ: 1900-8888</div>
                    </div>
                `;

                document.getElementById('receiptPreview').innerHTML = html;
                const modal = new bootstrap.Modal(document.getElementById('printModal'));
                modal.show();
            } catch (err) {
                console.error(err);
                alert('Không thể kết nối đến máy chủ.');
            }
        }
    </script>
}
