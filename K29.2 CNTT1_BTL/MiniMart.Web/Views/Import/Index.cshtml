@model List<MiniMart.Web.Models.Entities.ImportReceipt>
@{
    ViewData["Title"] = "Quản lý nhập hàng";
    var suppliers = ViewBag.Suppliers as List<MiniMart.Web.Models.Entities.Supplier> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 text-slate-900 fw-bold">Quản lý nhập hàng từ nhà cung cấp</h2>
        <p class="text-muted small mb-0">Tạo phiếu nhập, cập nhật giá nhập và quản lý hạn sử dụng của từng lô hàng</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" 
           asp-route-keyword="@ViewBag.Keyword"
           asp-route-status="@ViewBag.Status"
           asp-route-supplierId="@ViewBag.SupplierId"
           class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel (CSV)
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Tạo phiếu nhập kho
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng số phiếu nhập</div>
                    <div class="stat-value">@ViewBag.TotalCount</div>
                    <div class="small text-muted">Đã duyệt: <span class="text-success fw-bold">@ViewBag.CompletedCount</span> phiếu</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng giá trị nhập kho</div>
                    <div class="stat-value text-success">@(((decimal)(ViewBag.TotalImportAmount ?? 0)).ToString("N0"))đ</div>
                    <div class="small text-muted">Từ các phiếu đã hoàn thành</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <div class="stat-label">Nhà cung cấp đối tác</div>
                    <div class="stat-value text-info">@suppliers.Count</div>
                    <div class="small text-muted">Đang hoạt động cung ứng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control bg-light border-start-0" placeholder="Mã phiếu, NCC, người tạo..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="supplierId" class="form-select bg-light">
                    <option value="">Tất cả nhà cung cấp</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id" selected="@(s.Id == ViewBag.SupplierId)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select bg-light">
                    <option value="ALL" selected="@(ViewBag.Status == "ALL" || string.IsNullOrEmpty(ViewBag.Status))">Tất cả trạng thái</option>
                    <option value="COMPLETED" selected="@(ViewBag.Status == "COMPLETED")">Đã nhập kho (Hoàn thành)</option>
                    <option value="DRAFT" selected="@(ViewBag.Status == "DRAFT")">Bản nháp (Chưa duyệt)</option>
                    <option value="CANCELLED" selected="@(ViewBag.Status == "CANCELLED")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng phiếu nhập -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Ngày nhập</th>
                    <th>Người tạo</th>
                    <th class="text-center">Số mặt hàng</th>
                    <th class="text-end">Tổng tiền nhập</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-truck display-4 d-block mb-2 text-slate-300"></i>
                            Không có phiếu nhập kho nào khớp với tiêu chí tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@r.Id" class="fw-bold text-primary text-decoration-none">
                                    #@r.ReceiptCode
                                </a>
                                <div class="small text-muted" style="font-size: 11px;">@r.Store?.Name</div>
                            </td>
                            <td>
                                <div class="fw-medium text-slate-900">@r.Supplier?.Name</div>
                                <div class="small text-muted" style="font-size: 11px;">SĐT: @(r.Supplier?.Phone ?? "N/A")</div>
                            </td>
                            <td>
                                <div>@r.ImportDate.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted" style="font-size: 11px;">@r.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="small fw-medium">@r.CreatedByUser?.FullName</div>
                                <div class="text-muted" style="font-size: 11px;">@@@r.CreatedByUser?.Username</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@r.ImportReceiptItems.Count SP</span>
                            </td>
                            <td class="text-end fw-bold text-slate-900">
                                @r.TotalAmount.ToString("N0")đ
                            </td>
                            <td class="text-center">
                                @if (r.Status == "COMPLETED")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i> Đã nhập kho
                                    </span>
                                }
                                else if (r.Status == "DRAFT")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="bi bi-clock me-1"></i> Phiếu nháp
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-circle me-1"></i> Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-secondary btn-sm" title="Xem chi tiết">
                                    <i class="bi bi-eye me-1"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng số @ViewBag.TotalCount phiếu nhập)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-keyword="@ViewBag.Keyword"
                           asp-route-supplierId="@ViewBag.SupplierId"
                           asp-route-status="@ViewBag.Status">Trước</a>
                    </li>
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p"
                               asp-route-keyword="@ViewBag.Keyword"
                               asp-route-supplierId="@ViewBag.SupplierId"
                               asp-route-status="@ViewBag.Status">@p</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-keyword="@ViewBag.Keyword"
                           asp-route-supplierId="@ViewBag.SupplierId"
                           asp-route-status="@ViewBag.Status">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
