@model MiniMart.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan hoạt động";
}

<!-- Lời chào & Lối tắt nhanh -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 text-slate-900 fw-bold">Bảng điều khiển kinh doanh</h2>
        <p class="text-muted small mb-0">Theo dõi doanh thu, hiệu suất bán hàng và sức khỏe kho hàng theo thời gian thực</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Pos" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-cart3 me-1"></i> Bán hàng (POS)
        </a>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-graph-up me-1"></i> Báo cáo chi tiết
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Doanh thu hôm nay -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card shadow-sm h-100">
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Doanh thu hôm nay</div>
                <div class="fs-4 fw-bold text-dark">@Model.TodayRevenue.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="small text-muted" style="font-size: 11.5px;">Số lượng: <strong class="text-primary">@Model.TodayInvoicesCount</strong> đơn hàng</div>
            </div>
        </div>
    </div>

    <!-- Doanh thu tháng này -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card shadow-sm h-100">
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Doanh thu tháng này</div>
                <div class="fs-4 fw-bold text-success">@Model.MonthRevenue.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="small text-muted" style="font-size: 11.5px;">Tổng cộng: <strong class="text-success">@Model.MonthInvoicesCount</strong> hóa đơn</div>
            </div>
        </div>
    </div>

    <!-- Tổng mặt hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card shadow-sm h-100">
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Tổng sản phẩm kinh doanh</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalProductsCount <span class="fs-6 fw-normal text-muted">SP</span></div>
                <div class="small text-muted" style="font-size: 11.5px;">Đang hoạt động trong danh mục</div>
            </div>
        </div>
    </div>

    <!-- Khách hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card shadow-sm h-100">
            <div class="stat-icon bg-warning-subtle text-warning">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Khách hàng tích điểm</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalCustomersCount <span class="fs-6 fw-normal text-muted">thành viên</span></div>
                <div class="small text-muted" style="font-size: 11.5px;">Hệ thống thành viên & ưu đãi</div>
            </div>
        </div>
    </div>
</div>

<!-- Cảnh báo kho hàng -->
@if (Model.LowStockCount > 0 || Model.NearExpiryBatchCount > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card bg-warning-subtle border-0 shadow-sm d-flex flex-row align-items-center justify-content-between p-3 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 text-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Cảnh báo tồn kho & hạn sử dụng cần xử lý!</div>
                        <div class="small text-muted">
                            Hệ thống ghi nhận <strong class="text-danger">@Model.LowStockCount</strong> mặt hàng dưới định mức tồn kho an toàn và 
                            <strong class="text-danger">@Model.NearExpiryBatchCount</strong> lô hàng cận date (≤30 ngày).
                        </div>
                    </div>
                </div>
                <div>
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-warning btn-sm rounded-3 fw-semibold shadow-sm">
                        Kiểm tra kho ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Hàng Biểu đồ Chart.js -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ Doanh thu 7 ngày gần nhất -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-0 text-slate-800">
                        <i class="bi bi-graph-up text-primary me-2"></i>Doanh thu 7 ngày gần nhất
                    </h6>
                    <small class="text-muted">Biểu đồ doanh thu thực tế và số lượng đơn hàng hoàn thành</small>
                </div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    7 ngày qua
                </span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="revenueTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Cơ cấu phương thức thanh toán -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Cơ cấu thanh toán tháng này
                </h6>
                <small class="text-muted">Tỷ lệ các hình thức thanh toán</small>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="width: 200px; height: 200px; position: relative;" class="mb-3">
                    <canvas id="paymentMethodChart"></canvas>
                </div>
                <div class="w-100 d-flex justify-content-around text-center border-top pt-2 small text-muted">
                    <div>
                        <div class="fw-bold text-dark">@Model.CashOrdersCount</div>
                        <div style="font-size: 11px;"><i class="bi bi-circle-fill text-success me-1"></i>Tiền mặt</div>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@Model.TransferOrdersCount</div>
                        <div style="font-size: 11px;"><i class="bi bi-circle-fill text-primary me-1"></i>QR/Chuyển khoản</div>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@Model.CardOrdersCount</div>
                        <div style="font-size: 11px;"><i class="bi bi-circle-fill text-info me-1"></i>Thẻ</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hàng Bảng chi tiết: Top Bán Chạy & Hóa Đơn Gần Đây -->
<div class="row g-4">
    <!-- Top 5 sản phẩm bán chạy nhất tháng -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-trophy text-warning me-2"></i>Top 5 sản phẩm bán chạy tháng này
                </h6>
                <a asp-controller="Products" asp-action="Index" class="small text-decoration-none fw-semibold">Xem kho &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.TopSellingProducts.Any())
                {
                    <div class="list-group list-group-flush">
                        @for (int i = 0; i < Model.TopSellingProducts.Count; i++)
                        {
                            var item = Model.TopSellingProducts[i];
                            var medalBadge = i switch
                            {
                                0 => "<span class='badge bg-warning text-dark me-2'>#1</span>",
                                1 => "<span class='badge bg-secondary text-white me-2'>#2</span>",
                                2 => "<span class='badge bg-danger text-white me-2'>#3</span>",
                                _ => $"<span class='badge bg-light text-muted border me-2'>#{i + 1}</span>"
                            };

                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center">
                                        @Html.Raw(medalBadge)
                                        <div>
                                            <div class="fw-bold small text-slate-900">@item.ProductName</div>
                                            <div class="text-muted" style="font-size: 11px;">Mã: @item.ProductCode · Danh mục: @item.CategoryName</div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-primary small">@item.TotalRevenue.ToString("N0")đ</div>
                                        <div class="text-muted" style="font-size: 11px;">Đã bán: <strong class="text-dark">@item.QuantitySold</strong></div>
                                    </div>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @item.PercentageOfMax%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                        Chưa có dữ liệu bán hàng tháng này.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Hóa đơn gần đây -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-slate-800">
                    <i class="bi bi-clock-history text-primary me-2"></i>Đơn hàng gần nhất
                </h6>
                <a asp-controller="Invoices" asp-action="Index" class="small text-decoration-none fw-semibold">Xem tất cả &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentInvoices.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã HĐ</th>
                                    <th>Khách hàng</th>
                                    <th>Thu ngân</th>
                                    <th class="text-end">Tổng tiền</th>
                                    <th class="text-end pe-3">Thời gian</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="fw-bold text-primary text-decoration-none">
                                                #@inv.InvoiceCode
                                            </a>
                                        </td>
                                        <td>@(inv.Customer?.FullName ?? "Khách lẻ")</td>
                                        <td class="text-muted">@(inv.Cashier?.FullName ?? "Thu ngân")</td>
                                        <td class="text-end fw-bold">@inv.TotalAmount.ToString("N0")đ</td>
                                        <td class="text-end pe-3 text-muted" style="font-size: 11px;">@inv.CreatedAt.ToString("HH:mm dd/MM")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                        Chưa có đơn hàng nào được tạo hôm nay.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Biểu đồ đường doanh thu 7 ngày gần nhất
    const ctxTrend = document.getElementById('revenueTrendChart').getContext('2d');
    const trendDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDates));
    const trendRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartRevenues));
    const trendOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartOrders));

    new Chart(ctxTrend, {
        type: 'line',
        data: {
            labels: trendDates,
            datasets: [
                {
                    label: 'Doanh thu (VNĐ)',
                    data: trendRevenues,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.08)',
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#2563eb',
                    pointRadius: 4,
                    yAxisID: 'y'
                },
                {
                    label: 'Số đơn hàng',
                    data: trendOrders,
                    borderColor: '#10b981',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointBackgroundColor: '#10b981',
                    pointRadius: 3,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 12, font: { size: 12 } }
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            if (context.dataset.yAxisID === 'y') {
                                return ' Doanh thu: ' + Number(context.parsed.y).toLocaleString() + ' đ';
                            } else {
                                return ' Số đơn: ' + context.parsed.y + ' đơn';
                            }
                        }
                    }
                }
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    ticks: {
                        callback: function (val) {
                            if (val >= 1000000) return (val / 1000000) + 'Tr';
                            if (val >= 1000) return (val / 1000) + 'k';
                            return val;
                        }
                    },
                    grid: { color: '#f1f5f9' }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    grid: { drawOnChartArea: false },
                    ticks: { stepSize: 1 }
                },
                x: {
                    grid: { display: false }
                }
            }
        }
    });

    // 2. Biểu đồ tròn cơ cấu thanh toán
    const ctxPayment = document.getElementById('paymentMethodChart').getContext('2d');
    const cashCount = @Model.CashOrdersCount;
    const transferCount = @Model.TransferOrdersCount;
    const cardCount = @Model.CardOrdersCount;

    const totalOrders = cashCount + transferCount + cardCount;
    const paymentData = totalOrders > 0 ? [cashCount, transferCount, cardCount] : [1, 0, 0];
    const paymentColors = totalOrders > 0 ? ['#10b981', '#2563eb', '#06b6d4'] : ['#e2e8f0', '#e2e8f0', '#e2e8f0'];

    new Chart(ctxPayment, {
        type: 'doughnut',
        data: {
            labels: ['Tiền mặt', 'Chuyển khoản QR', 'Thẻ'],
            datasets: [{
                data: paymentData,
                backgroundColor: paymentColors,
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            if (totalOrders === 0) return ' Chưa có dữ liệu';
                            const val = context.parsed;
                            const pct = Math.round((val / totalOrders) * 100);
                            return ` ${context.label}: ${val} đơn (${pct}%)`;
                        }
                    }
                }
            },
            cutout: '70%'
        }
    });
</script>
}
