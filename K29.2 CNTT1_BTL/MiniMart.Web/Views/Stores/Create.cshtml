@model MiniMart.Web.Models.Entities.Store
@{
    ViewData["Title"] = "Thêm chi nhánh mới";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-shop me-2 text-primary"></i> Thêm chi nhánh mới</h5>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StoreCode" class="form-label small fw-semibold">Mã chi nhánh *</label>
                        <input asp-for="StoreCode" class="form-control" />
                        <span asp-validation-for="StoreCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreType" class="form-label small fw-semibold">Loại hình</label>
                        <select asp-for="StoreType" class="form-select">
                            <option value="MINI_MART">Siêu thị mini</option>
                            <option value="DISTRIBUTOR">Cửa hàng phân phối</option>
                            <option value="AGENCY">Đại lý</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold">Tên chi nhánh / Cửa hàng *</label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: MiniMart Cầu Giấy" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ *</label>
                    <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/TP" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" placeholder="09xxxxxxx" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email liên hệ</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="branch@minimart.vn" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Lưu chi nhánh</button>
                </div>
            </form>
        </div>
    </div>
</div>

