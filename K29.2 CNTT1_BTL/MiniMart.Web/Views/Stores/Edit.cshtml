@model MiniMart.Web.Models.Entities.Store
@{
    ViewData["Title"] = "Chỉnh sửa chi nhánh";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i> Chỉnh sửa chi nhánh: @Model.Name</h5>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="StoreCode" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mã chi nhánh</label>
                        <input value="@Model.StoreCode" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreType" class="form-label small fw-semibold">Loại hình</label>
                        <select asp-for="StoreType" class="form-select">
                            <option value="MINI_MART">Siêu thị mini</option>
                            <option value="DISTRIBUTOR">Cửa hàng phân phối</option>
                            <option value="AGENCY">Đại lý</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold">Tên chi nhánh *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ *</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label small fw-semibold">Trạng thái hoạt động</label>
                    <select asp-for="Status" class="form-select">
                        <option value="ACTIVE">Hoạt động</option>
                        <option value="INACTIVE">Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

