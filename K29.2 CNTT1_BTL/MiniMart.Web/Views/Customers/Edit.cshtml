@model MiniMart.Web.Models.Entities.Customer
@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom">
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i> Sửa hồ sơ: @Model.FullName (@Model.MemberCode)</h5>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="MemberCode" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mã thành viên</label>
                        <input value="@Model.MemberCode" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại *</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên *</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="MembershipTier" class="form-label small fw-semibold">Hạng hội viên</label>
                        <select asp-for="MembershipTier" class="form-select">
                            <option value="MEMBER">Thành viên</option>
                            <option value="SILVER">Bạc (Silver)</option>
                            <option value="GOLD">Vàng (Gold)</option>
                            <option value="DIAMOND">Kim Cương (Diamond)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label small fw-semibold">Trạng thái thẻ</label>
                        <select asp-for="Status" class="form-select">
                            <option value="ACTIVE">Hoạt động</option>
                            <option value="DISABLED">Đang khóa</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label small fw-semibold">Ngày sinh</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

