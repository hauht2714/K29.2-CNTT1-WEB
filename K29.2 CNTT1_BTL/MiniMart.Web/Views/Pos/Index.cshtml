@{
    ViewData["Title"] = "Bán hàng tại quầy (POS)";
    var categories = ViewBag.Categories as IEnumerable<MiniMart.Web.Models.Entities.Category> ?? new List<MiniMart.Web.Models.Entities.Category>();
}

<style>
    /* POS specialized styling */
    .pos-container {
        display: flex;
        gap: 20px;
        height: calc(100vh - 110px);
    }
    .pos-catalog {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        padding: 18px;
        overflow: hidden;
    }
    .pos-cart {
        width: 450px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        padding: 18px;
    }
    .product-grid {
        flex: 1;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        padding-right: 4px;
        align-content: start;
    }
    .pos-prod-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        background: #fff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 120px;
    }
    .pos-prod-card:hover {
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
        transform: translateY(-2px);
    }
    .pos-prod-card.out-of-stock {
        opacity: 0.55;
        cursor: not-allowed;
        background: #f8fafc;
    }
    .cart-items-box {
        flex: 1;
        overflow-y: auto;
        margin-bottom: 12px;
        border-bottom: 1px solid var(--border);
        padding-right: 4px;
    }
    .cart-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #f1f5f9;
    }
    .qty-btn {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        font-weight: bold;
        font-size: 13px;
    }
    .qty-btn:hover { background: #e2e8f0; }
    .cash-chip {
        font-size: 11.5px;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        cursor: pointer;
    }
    .cash-chip:hover { background: #e2e8f0; }
    
    .order-tab {
        font-weight: 600;
        font-size: 13px;
        border-radius: 8px;
        transition: all 0.15s;
    }

    /* Thermal receipt printer preview */
    @@media print {
        body * { visibility: hidden; }
        #thermalReceipt, #thermalReceipt * { visibility: visible; }
        #thermalReceipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 80mm;
            padding: 10px;
            font-size: 12px;
            font-family: monospace;
        }
    }
</style>

<div class="pos-container">
    <!-- Cột trái: Tìm kiếm & Danh mục sản phẩm -->
    <div class="pos-catalog">
        <!-- Ô quét mã vạch / Tìm kiếm -->
        <div class="mb-3">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-light border-end-0 text-primary">
                    <i class="bi bi-upc-scan fs-4"></i>
                </span>
                <input type="text" id="barcodeInput" class="form-control border-start-0 font-monospace" 
                       placeholder="Quét mã vạch hoặc gõ tên sản phẩm... (F2)" autofocus autocomplete="off" />
                <button class="btn btn-outline-secondary" type="button" id="btnClearSearch" title="Xóa tìm kiếm">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <!-- Danh mục sản phẩm dạng Tabs cuộn ngang -->
        <div class="d-flex gap-2 overflow-x-auto pb-2 mb-3" style="white-space: nowrap;">
            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 cat-btn active" data-cat="">
                Tất cả hàng hóa
            </button>
            @foreach (var c in categories)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 cat-btn" data-cat="@c.Id">
                    @c.Name
                </button>
            }
        </div>

        <!-- Lưới sản phẩm -->
        <div class="product-grid" id="productGrid">
            <!-- Sản phẩm được render động bằng JavaScript -->
        </div>
    </div>

    <!-- Cột phải: Multi-Cart Giỏ hàng & Thanh toán -->
    <div class="pos-cart">
        <!-- Thanh chuyển đổi tab Treo đơn (Multi-Order) -->
        <div class="d-flex gap-1 mb-2">
            <button type="button" class="btn btn-sm btn-primary flex-fill order-tab active" id="tabBtn1" onclick="switchOrderTab(1)">
                <i class="bi bi-cart me-1"></i> Đơn 1 <span class="badge bg-white text-primary ms-1" id="tabBadge1">0</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill order-tab" id="tabBtn2" onclick="switchOrderTab(2)">
                <i class="bi bi-cart me-1"></i> Đơn 2 <span class="badge bg-secondary ms-1" id="tabBadge2">0</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill order-tab" id="tabBtn3" onclick="switchOrderTab(3)">
                <i class="bi bi-cart me-1"></i> Đơn 3 <span class="badge bg-secondary ms-1" id="tabBadge3">0</span>
            </button>
        </div>

        <!-- Tìm & Tích điểm khách hàng -->
        <div class="card p-2 bg-light border-0 rounded-3 mb-2">
            <div class="input-group input-group-sm mb-1">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                <input type="text" id="custPhoneInput" class="form-control border-start-0" placeholder="SĐT khách hàng tích điểm..." />
                <button class="btn btn-primary" type="button" id="btnSearchCust">Tìm</button>
            </div>
            <div id="custInfoBox" class="d-none small mt-1 pt-1 border-top d-flex justify-content-between align-items-center">
                <div>
                    <strong id="custNameDisplay" class="text-primary"></strong>
                    <span id="custTierBadge" class="badge bg-warning text-dark ms-1"></span>
                    <div class="text-muted" style="font-size: 11px;">Điểm khả dụng: <span id="custPointsDisplay" class="fw-bold text-success">0</span></div>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="chkUsePoints">
                    <label class="form-check-label small fw-semibold" for="chkUsePoints">Dùng điểm</label>
                </div>
            </div>
        </div>

        <!-- Danh sách món trong giỏ hàng -->
        <div class="d-flex justify-content-between align-items-center pb-2 mb-1 border-bottom">
            <span class="fw-bold small text-muted">MÓN HÀNG (<span id="cartCount">0</span>)</span>
            <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" id="btnClearCart">
                <i class="bi bi-trash3 me-1"></i> Xóa giỏ
            </button>
        </div>

        <div class="cart-items-box" id="cartItemsList">
            <div class="text-center py-5 text-muted small" id="emptyCartNotice">
                <i class="bi bi-cart-x fs-1 d-block mb-1 text-secondary opacity-50"></i>
                Giỏ hàng đang trống. Hãy quét mã vạch hoặc chọn sản phẩm bên trái!
            </div>
        </div>

        <!-- Tổng tiền & Phương thức thanh toán -->
        <div class="border-top pt-2">
            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Tạm tính:</span>
                <span id="lblSubtotal" class="fw-semibold text-dark">0 đ</span>
            </div>
            <div class="d-flex justify-content-between small text-success mb-1 d-none" id="rowPointsDiscount">
                <span>Trừ điểm thành viên:</span>
                <span id="lblPointsDiscount">-0 đ</span>
            </div>
            <div class="d-flex justify-content-between fs-5 fw-bold text-dark mb-2">
                <span>Tổng thanh toán:</span>
                <span id="lblTotal" class="text-primary">0 đ</span>
            </div>

            <!-- Phương thức thanh toán -->
            <div class="btn-group w-100 mb-2" role="group">
                <input type="radio" class="btn-check" name="payMethod" id="payCash" value="CASH" checked>
                <label class="btn btn-outline-primary btn-sm" for="payCash"><i class="bi bi-cash me-1"></i> Tiền mặt</label>

                <input type="radio" class="btn-check" name="payMethod" id="payBank" value="BANK_TRANSFER">
                <label class="btn btn-outline-primary btn-sm" for="payBank"><i class="bi bi-qr-code me-1"></i> VietQR</label>

                <input type="radio" class="btn-check" name="payMethod" id="payWallet" value="E_WALLET">
                <label class="btn btn-outline-primary btn-sm" for="payWallet"><i class="bi bi-wallet2 me-1"></i> Ví điện tử</label>
            </div>

            <!-- Tiền khách đưa (Tiền mặt) -->
            <div id="cashInputSection">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text bg-white text-muted">Khách đưa:</span>
                    <input type="number" id="txtCashReceived" class="form-control text-end fw-bold" placeholder="0" />
                    <span class="input-group-text bg-white">đ</span>
                </div>
                <!-- Gợi ý mệnh giá nhanh -->
                <div class="d-flex gap-1 flex-wrap mb-1" id="cashSuggestionsBox">
                    <button type="button" class="cash-chip" onclick="setCash(0, true)">Đúng số tiền</button>
                    <button type="button" class="cash-chip" onclick="setCash(50000)">50k</button>
                    <button type="button" class="cash-chip" onclick="setCash(100000)">100k</button>
                    <button type="button" class="cash-chip" onclick="setCash(200000)">200k</button>
                    <button type="button" class="cash-chip" onclick="setCash(500000)">500k</button>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">Tiền thừa trả khách:</span>
                    <span id="lblCashChange" class="fw-bold text-success fs-6">0 đ</span>
                </div>
            </div>

            <!-- Khối hiển thị mã VietQR chuyển khoản tự động -->
            <div id="qrPaymentSection" class="d-none text-center p-2 mb-2 bg-light rounded-3 border">
                <div class="small fw-bold text-slate-800 mb-1">
                    <i class="bi bi-qr-code-scan text-primary me-1"></i> Quét mã VietQR để thanh toán nhanh
                </div>
                <div class="bg-white p-2 rounded border d-inline-block shadow-sm mb-1">
                    <img id="vietQrImg" src="" alt="VietQR" style="width: 160px; height: 160px; object-fit: contain;" />
                </div>
                <div class="small text-muted" style="font-size: 11px;">
                    Ngân hàng: <strong>MBBank</strong> - STK: <strong>0987654321</strong><br/>
                    Chủ TK: <strong>CONG TY TNHH MINIMART</strong>
                </div>
            </div>

            <!-- Nút Thanh Toán -->
            <button type="button" id="btnCheckout" class="btn btn-success w-100 py-2 fs-5 fw-bold rounded-3 shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> THANH TOÁN (F9)
            </button>
        </div>
    </div>
</div>

<!-- Modal Hóa đơn in nhiệt (Print Receipt) -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-body p-4" id="thermalReceipt">
                <div class="text-center mb-3">
                    <h5 class="fw-bold mb-0 text-uppercase" id="rcStoreName">MINIMART</h5>
                    <div class="small text-muted" id="rcStoreAddress">123 Nguyễn Huệ, Quận 1, TP. HCM</div>
                    <div class="small text-muted" id="rcStorePhone">SĐT: 02838221144</div>
                    <div class="border-top border-bottom my-2 py-1 fw-bold fs-6">HÓA ĐƠN BÁN LẺ</div>
                </div>

                <div class="small mb-2">
                    <div class="d-flex justify-content-between">
                        <span>Số HĐ: <strong id="rcInvoiceCode"></strong></span>
                        <span id="rcCreatedAt"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Thu ngân: <span id="rcCashier"></span></span>
                        <span>Khách: <strong id="rcCustomer"></strong></span>
                    </div>
                </div>

                <table class="table table-sm border-top border-bottom small mb-2">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đ.Giá</th>
                            <th class="text-end">T.Tiền</th>
                        </tr>
                    </thead>
                    <tbody id="rcItemsBody"></tbody>
                </table>

                <div class="small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Cộng tiền hàng:</span>
                        <strong id="rcSubtotal">0 đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 d-none" id="rcRowDiscount">
                        <span>Giảm giá trừ điểm:</span>
                        <strong id="rcPointsDiscount">-0 đ</strong>
                    </div>
                    <div class="d-flex justify-content-between fs-6 fw-bold border-top pt-1 mb-1">
                        <span>TỔNG CỘNG:</span>
                        <span class="text-primary fs-5" id="rcTotal">0 đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>Phương thức TT:</span>
                        <span id="rcPayMethod">Tiền mặt</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>Khách đưa:</span>
                        <span id="rcCashReceived">0 đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 text-muted">
                        <span>Tiền thối lại:</span>
                        <strong class="text-success" id="rcCashChange">0 đ</strong>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-1 text-muted d-none" id="rcPointsEarnedBox">
                        <span>Điểm tích lũy lần này:</span>
                        <strong class="text-primary" id="rcPointsEarned">+0 điểm</strong>
                    </div>
                </div>

                <div class="text-center mt-3 small text-muted">
                    <div>*** CẢM ƠN QUÝ KHÁCH ***</div>
                    <div>Hẹn gặp lại quý khách lần sau!</div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnCloseReceipt">Đóng (Đơn mới)</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In hóa đơn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let products = [];
    let currentCategory = '';

    // Multi-cart Tabs state (Treo Đơn 1, 2, 3)
    let currentTab = 1;
    let tabsData = {
        1: { cart: [], customer: null, cashReceived: '', usePoints: false, payMethod: 'CASH' },
        2: { cart: [], customer: null, cashReceived: '', usePoints: false, payMethod: 'CASH' },
        3: { cart: [], customer: null, cashReceived: '', usePoints: false, payMethod: 'CASH' }
    };

    let cart = tabsData[1].cart;
    let currentCustomer = tabsData[1].customer;

    // Web Audio Synthesizer Beep Feedback
    function playBeep(freq = 1750, duration = 0.08) {
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(0.12, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {
            // Ignore audio context block
        }
    }

    $(document).ready(function () {
        loadProducts();

        // Phím tắt F2 focus tìm kiếm, F9 thanh toán
        $(document).keydown(function (e) {
            if (e.key === 'F2') {
                e.preventDefault();
                $('#barcodeInput').focus().select();
            } else if (e.key === 'F9') {
                e.preventDefault();
                $('#btnCheckout').click();
            }
        });

        // Tìm kiếm / Quét mã vạch khi nhấn Enter
        $('#barcodeInput').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                handleBarcodeEnter();
            }
        });

        $('#btnClearSearch').click(function () {
            $('#barcodeInput').val('').focus();
            loadProducts();
        });

        // Lọc danh mục
        $('.cat-btn').click(function () {
            $('.cat-btn').removeClass('btn-primary active').addClass('btn-outline-secondary');
            $(this).removeClass('btn-outline-secondary').addClass('btn-primary active');
            currentCategory = $(this).data('cat');
            loadProducts();
        });

        // Tìm kiếm khách hàng
        $('#btnSearchCust').click(searchCustomer);
        $('#custPhoneInput').keypress(function (e) {
            if (e.which === 13) {
                e.preventDefault();
                searchCustomer();
            }
        });

        $('#chkUsePoints').change(updateTotals);
        $('#txtCashReceived').on('input', updateTotals);

        $('input[name="payMethod"]').change(function () {
            handlePayMethodChange();
        });

        $('#btnClearCart').click(function () {
            if (cart.length > 0 && confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng của đơn này?')) {
                cart = [];
                renderCart();
            }
        });

        $('#btnCheckout').click(processCheckout);
    });

    function switchOrderTab(tabId) {
        if (tabId === currentTab) return;

        // Lưu trạng thái của tab hiện tại
        tabsData[currentTab].cart = cart;
        tabsData[currentTab].customer = currentCustomer;
        tabsData[currentTab].cashReceived = $('#txtCashReceived').val();
        tabsData[currentTab].usePoints = $('#chkUsePoints').is(':checked');
        tabsData[currentTab].payMethod = $('input[name="payMethod"]:checked').val();

        // Cập nhật UI nút tab
        $('.order-tab').removeClass('btn-primary active').addClass('btn-outline-secondary');
        $(`#tabBtn${tabId}`).removeClass('btn-outline-secondary').addClass('btn-primary active');

        // Chuyển sang tab mới
        currentTab = tabId;
        cart = tabsData[currentTab].cart;
        currentCustomer = tabsData[currentTab].customer;

        // Khôi phục giao diện khách hàng
        if (currentCustomer) {
            $('#custNameDisplay').text(currentCustomer.fullName);
            $('#custPointsDisplay').text(Number(currentCustomer.totalPoints).toLocaleString());
            $('#custTierBadge').text(currentCustomer.membershipTier);
            $('#custPhoneInput').val(currentCustomer.phone);
            $('#custInfoBox').removeClass('d-none');
        } else {
            $('#custPhoneInput').val('');
            $('#custInfoBox').addClass('d-none');
        }

        $('#chkUsePoints').prop('checked', tabsData[currentTab].usePoints);
        $('#txtCashReceived').val(tabsData[currentTab].cashReceived);
        $(`input[name="payMethod"][value="${tabsData[currentTab].payMethod}"]`).prop('checked', true);

        renderCart();
        handlePayMethodChange();
    }

    function updateTabBadges() {
        for (let i = 1; i <= 3; i++) {
            const count = (i === currentTab ? cart : tabsData[i].cart).reduce((s, it) => s + it.quantity, 0);
            const badge = $(`#tabBadge${i}`);
            badge.text(count);
            if (i === currentTab) {
                badge.removeClass('bg-secondary text-white').addClass('bg-white text-primary');
            } else {
                badge.removeClass('bg-white text-primary').addClass('bg-secondary text-white');
            }
        }
    }

    function handlePayMethodChange() {
        const m = $('input[name="payMethod"]:checked').val();
        if (m === 'CASH') {
            $('#cashInputSection').removeClass('d-none');
            $('#qrPaymentSection').addClass('d-none');
        } else {
            $('#cashInputSection').addClass('d-none');
            $('#qrPaymentSection').removeClass('d-none');
            updateVietQr();
        }
    }

    function updateVietQr() {
        const subtotal = cart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
        let pointsDiscount = 0;
        if (currentCustomer && $('#chkUsePoints').is(':checked')) {
            const maxPoints = Math.floor(subtotal / 1000);
            pointsDiscount = Math.min(currentCustomer.totalPoints, maxPoints) * 1000;
        }
        const total = Math.max(0, subtotal - pointsDiscount);

        if (total > 0) {
            const addInfo = encodeURIComponent("MINIMART" + Math.floor(100000 + Math.random() * 900000));
            const qrUrl = `https://img.vietqr.io/image/970422-0987654321-compact2.png?amount=${total}&addInfo=${addInfo}&accountName=CONG%20TY%20TNHH%20MINIMART`;
            $('#vietQrImg').attr('src', qrUrl);
        } else {
            $('#vietQrImg').attr('src', '');
        }
    }

    function loadProducts() {
        const kw = $('#barcodeInput').val();
        $.get('/Pos/GetProducts', { keyword: kw, categoryId: currentCategory }, function (res) {
            products = res;
            renderProductGrid();
        });
    }

    function renderProductGrid() {
        const grid = $('#productGrid');
        grid.empty();

        if (products.length === 0) {
            grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block mb-1"></i>Không tìm thấy sản phẩm nào.</div>');
            return;
        }

        products.forEach(p => {
            const isOut = p.stockQuantity <= 0;
            const stockBadge = isOut 
                ? '<span class="badge bg-danger">Hết hàng</span>' 
                : `<span class="badge bg-light text-dark border">Còn ${p.stockQuantity} ${p.unit}</span>`;

            const promoBadge = p.promoTag ? `<span class="badge bg-danger ms-1" style="font-size: 10px;"><i class="bi bi-tag-fill me-1"></i>${p.promoTag}</span>` : '';
            const priceHtml = p.promoTag && p.originalPrice > p.price
                ? `<div>
                     <span class="fw-bold text-danger">${Number(p.price).toLocaleString()} đ</span>
                     <span class="text-muted text-decoration-line-through small ms-1" style="font-size: 10.5px;">${Number(p.originalPrice).toLocaleString()}</span>
                     ${promoBadge}
                   </div>`
                : `<div>
                     <span class="fw-bold text-primary">${Number(p.price).toLocaleString()} đ</span>
                     ${promoBadge}
                   </div>`;

            const card = $(`
                <div class="pos-prod-card ${isOut ? 'out-of-stock' : ''}" data-id="${p.id}">
                    <div>
                        <div class="fw-bold small text-dark text-truncate" title="${p.name}">${p.name}</div>
                        <div class="text-muted font-monospace" style="font-size: 11px;">${p.barcode || p.productCode}</div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        ${priceHtml}
                        ${stockBadge}
                    </div>
                </div>
            `);

            if (!isOut) {
                card.click(function () { addToCart(p); });
            }

            grid.append(card);
        });
    }

    function handleBarcodeEnter() {
        const code = $('#barcodeInput').val().trim();
        if (!code) return;

        const match = products.find(p => (p.barcode && p.barcode.toLowerCase() === code.toLowerCase()) || 
                                          p.productCode.toLowerCase() === code.toLowerCase());
        if (match) {
            addToCart(match);
            $('#barcodeInput').val('').focus();
        } else {
            loadProducts();
        }
    }

    function addToCart(p) {
        if (p.stockQuantity <= 0) {
            alert(`Sản phẩm "${p.name}" đã hết hàng!`);
            return;
        }

        const existing = cart.find(i => i.productId === p.id);
        if (existing) {
            if (existing.quantity + 1 > p.stockQuantity) {
                alert(`Chỉ còn ${p.stockQuantity} ${p.unit} trong kho.`);
                return;
            }
            existing.quantity++;
        } else {
            cart.push({
                productId: p.id,
                productName: p.name,
                productCode: p.productCode,
                unitPrice: p.price,
                unit: p.unit,
                maxStock: p.stockQuantity,
                quantity: 1
            });
        }
        playBeep();
        renderCart();
    }

    function renderCart() {
        const box = $('#cartItemsList');
        box.empty();

        if (cart.length === 0) {
            box.html(`
                <div class="text-center py-5 text-muted small" id="emptyCartNotice">
                    <i class="bi bi-cart-x fs-1 d-block mb-1 text-secondary opacity-50"></i>
                    Giỏ hàng đang trống. Hãy quét mã vạch hoặc chọn sản phẩm bên trái!
                </div>
            `);
            $('#cartCount').text('0');
            updateTabBadges();
            updateTotals();
            return;
        }

        $('#cartCount').text(cart.reduce((s, i) => s + i.quantity, 0));
        updateTabBadges();

        cart.forEach((item, idx) => {
            const sub = item.unitPrice * item.quantity;
            const row = $(`
                <div class="cart-row">
                    <div style="flex: 1; min-width: 0; padding-right: 8px;">
                        <div class="fw-semibold small text-truncate" title="${item.productName}">${item.productName}</div>
                        <div class="text-muted" style="font-size: 11px;">${Number(item.unitPrice).toLocaleString()} đ / ${item.unit}</div>
                    </div>
                    <div class="d-flex align-items-center gap-1 me-2">
                        <button type="button" class="qty-btn" onclick="changeQty(${idx}, -1)">-</button>
                        <span class="px-2 small fw-bold">${item.quantity}</span>
                        <button type="button" class="qty-btn" onclick="changeQty(${idx}, 1)">+</button>
                    </div>
                    <div class="text-end" style="min-width: 80px;">
                        <div class="fw-bold small">${Number(sub).toLocaleString()} đ</div>
                        <a href="javascript:void(0)" class="text-danger" style="font-size: 11px;" onclick="removeItem(${idx})">Xóa</a>
                    </div>
                </div>
            `);
            box.append(row);
        });

        updateTotals();
    }

    function changeQty(idx, delta) {
        const item = cart[idx];
        const newQty = item.quantity + delta;
        if (newQty <= 0) {
            cart.splice(idx, 1);
        } else if (newQty > item.maxStock) {
            alert(`Kho chỉ còn ${item.maxStock} ${item.unit}.`);
            item.quantity = item.maxStock;
        } else {
            item.quantity = newQty;
            playBeep(2100, 0.05);
        }
        renderCart();
    }

    function removeItem(idx) {
        cart.splice(idx, 1);
        renderCart();
    }

    function updateTotals() {
        const subtotal = cart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
        $('#lblSubtotal').text(Number(subtotal).toLocaleString() + ' đ');

        let pointsDiscount = 0;
        let pointsToUse = 0;

        if (currentCustomer && $('#chkUsePoints').is(':checked')) {
            const maxPoints = Math.floor(subtotal / 1000);
            pointsToUse = Math.min(currentCustomer.totalPoints, maxPoints);
            pointsDiscount = pointsToUse * 1000;
            $('#rowPointsDiscount').removeClass('d-none');
            $('#lblPointsDiscount').text('-' + Number(pointsDiscount).toLocaleString() + ' đ (' + pointsToUse + ' điểm)');
        } else {
            $('#rowPointsDiscount').addClass('d-none');
        }

        const total = Math.max(0, subtotal - pointsDiscount);
        $('#lblTotal').text(Number(total).toLocaleString() + ' đ');

        // Tiền thối lại
        const cashRec = Number($('#txtCashReceived').val()) || 0;
        const change = Math.max(0, cashRec - total);
        $('#lblCashChange').text(Number(change).toLocaleString() + ' đ');

        if ($('input[name="payMethod"]:checked').val() !== 'CASH') {
            updateVietQr();
        }
    }

    function setCash(amount, isExact = false) {
        if (isExact) {
            const subtotal = cart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            const ptsDisc = ($('#chkUsePoints').is(':checked') && currentCustomer) ? Math.min(currentCustomer.totalPoints, Math.floor(subtotal / 1000)) * 1000 : 0;
            $('#txtCashReceived').val(Math.max(0, subtotal - ptsDisc));
        } else {
            $('#txtCashReceived').val(amount);
        }
        updateTotals();
    }

    function searchCustomer() {
        const phone = $('#custPhoneInput').val().trim();
        if (!phone) return;

        $.get('/Pos/GetCustomerByPhone', { phone: phone }, function (res) {
            if (res.success) {
                currentCustomer = res.customer;
                $('#custNameDisplay').text(currentCustomer.fullName);
                $('#custPointsDisplay').text(Number(currentCustomer.totalPoints).toLocaleString());
                $('#custTierBadge').text(currentCustomer.membershipTier);
                $('#custInfoBox').removeClass('d-none');
                playBeep(2400, 0.1);
                updateTotals();
            } else {
                alert(res.message);
                currentCustomer = null;
                $('#custInfoBox').addClass('d-none');
            }
        });
    }

    function processCheckout() {
        if (cart.length === 0) {
            alert('Giỏ hàng đang trống!');
            return;
        }

        const subtotal = cart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
        let pointsToUse = 0;
        if (currentCustomer && $('#chkUsePoints').is(':checked')) {
            pointsToUse = Math.min(currentCustomer.totalPoints, Math.floor(subtotal / 1000));
        }
        const total = Math.max(0, subtotal - pointsToUse * 1000);
        const payMethod = $('input[name="payMethod"]:checked').val();
        const cashReceived = Number($('#txtCashReceived').val()) || total;

        if (payMethod === 'CASH' && cashReceived < total) {
            alert('Tiền khách đưa chưa đủ để thanh toán!');
            return;
        }

        const payload = {
            customerId: currentCustomer ? currentCustomer.id : null,
            paymentMethod: payMethod,
            cashReceived: cashReceived,
            discountAmount: 0,
            pointsToRedeem: pointsToUse,
            items: cart.map(i => ({
                productId: i.productId,
                productName: i.productName,
                productCode: i.productCode,
                quantity: i.quantity,
                unitPrice: i.unitPrice
            }))
        };

        $('#btnCheckout').prop('disabled', true).text('Đang thanh toán...');

        $.ajax({
            url: '/Pos/Checkout',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                $('#btnCheckout').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> THANH TOÁN (F9)');
                if (res.success) {
                    showReceiptModal(res.receipt);
                    // Dọn dẹp giỏ tab hiện tại
                    cart = [];
                    currentCustomer = null;
                    tabsData[currentTab].cart = [];
                    tabsData[currentTab].customer = null;
                    tabsData[currentTab].cashReceived = '';
                    tabsData[currentTab].usePoints = false;

                    $('#custInfoBox').addClass('d-none');
                    $('#custPhoneInput').val('');
                    $('#txtCashReceived').val('');
                    renderCart();
                    loadProducts();
                } else {
                    alert('Lỗi: ' + res.message);
                }
            },
            error: function () {
                $('#btnCheckout').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> THANH TOÁN (F9)');
                alert('Có lỗi xảy ra trong quá trình kết nối server.');
            }
        });
    }

    function showReceiptModal(rc) {
        $('#rcStoreName').text(rc.storeName);
        $('#rcStoreAddress').text(rc.storeAddress);
        $('#rcStorePhone').text('SĐT: ' + rc.storePhone);
        $('#rcInvoiceCode').text(rc.invoiceCode);
        $('#rcCreatedAt').text(new Date(rc.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' ' + new Date(rc.createdAt).toLocaleDateString('vi-VN'));
        $('#rcCashier').text(rc.cashierName);
        $('#rcCustomer').text(rc.customerName);

        const tbody = $('#rcItemsBody');
        tbody.empty();
        rc.items.forEach(item => {
            tbody.append(`
                <tr>
                    <td>${item.productName}</td>
                    <td class="text-center">${item.quantity}</td>
                    <td class="text-end">${Number(item.unitPrice).toLocaleString()}</td>
                    <td class="text-end font-monospace">${Number(item.subtotal).toLocaleString()}</td>
                </tr>
            `);
        });

        $('#rcSubtotal').text(Number(rc.subtotal).toLocaleString() + ' đ');
        if (rc.pointsDiscount > 0) {
            $('#rcRowDiscount').removeClass('d-none');
            $('#rcPointsDiscount').text('-' + Number(rc.pointsDiscount).toLocaleString() + ' đ');
        } else {
            $('#rcRowDiscount').addClass('d-none');
        }

        $('#rcTotal').text(Number(rc.totalAmount).toLocaleString() + ' đ');
        $('#rcPayMethod').text(rc.paymentMethod === 'CASH' ? 'Tiền mặt' : (rc.paymentMethod === 'BANK_TRANSFER' ? 'VietQR Chuyển khoản' : 'Ví điện tử'));
        $('#rcCashReceived').text(Number(rc.cashReceived).toLocaleString() + ' đ');
        $('#rcCashChange').text(Number(rc.cashChange).toLocaleString() + ' đ');

        if (rc.pointsEarned > 0) {
            $('#rcPointsEarnedBox').removeClass('d-none');
            $('#rcPointsEarned').text('+' + rc.pointsEarned + ' điểm (Tổng: ' + rc.newTotalPoints + ')');
        } else {
            $('#rcPointsEarnedBox').addClass('d-none');
        }

        const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
        modal.show();
    }
</script>
}
