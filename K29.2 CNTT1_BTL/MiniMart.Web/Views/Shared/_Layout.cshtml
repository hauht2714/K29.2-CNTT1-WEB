@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var currentFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
    var currentStoreName = User.FindFirst("StoreName")?.Value ?? "MiniMart Trụ Sở Chính";
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // Phân quyền theo vai trò (khớp với permissions.js trong bản mẫu)
    var canSeeDashboard = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "WAREHOUSE_STAFF";
    var canSeePos = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "CASHIER";
    var canSeeInvoices = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "CASHIER";
    var canSeeCustomers = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "CASHIER";
    var canSeeProducts = currentRole == "ADMIN" || currentRole == "STORE_MANAGER";
    var canSeePromotions = currentRole == "ADMIN" || currentRole == "STORE_MANAGER";
    var canSeeSuppliers = currentRole == "ADMIN" || currentRole == "STORE_MANAGER";
    var canSeeInventory = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "WAREHOUSE_STAFF";
    var canSeeImport = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "WAREHOUSE_STAFF";
    var canSeeTransfers = currentRole == "ADMIN" || currentRole == "STORE_MANAGER" || currentRole == "WAREHOUSE_STAFF";
    var canSeeAdmin = currentRole == "ADMIN";

    var roleTitle = currentRole switch
    {
        "ADMIN" => "Quản trị viên",
        "STORE_MANAGER" => "Quản lý cửa hàng",
        "CASHIER" => "Thu ngân",
        "WAREHOUSE_STAFF" => "Nhân viên kho",
        _ => currentRole
    };

    // Tạo chữ viết tắt Avatar (Nguyễn Văn An -> NA)
    var nameParts = currentFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 1 
        ? (nameParts[0][0].ToString() + nameParts[^1][0].ToString()).ToUpper() 
        : (currentFullName.Length >= 2 ? currentFullName[..2].ToUpper() : "U");

    var todayStr = DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!isAuthenticated)
    {
        <!-- Khi chưa đăng nhập (Layout tối giản) -->
        <div class="container py-4">
            @RenderBody()
        </div>
    }
    else
    {
        <!-- App Shell hoàn chỉnh khi đã đăng nhập -->
        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <div class="brand-icon">
                        <i class="bi bi-shop"></i>
                    </div>
                    <div>
                        <div class="brand-title">MiniMart</div>
                        <div class="brand-subtitle" title="@currentStoreName">@currentStoreName</div>
                    </div>
                </a>

                <div class="sidebar-menu">
                    <!-- Tổng quan -->
                    @if (canSeeDashboard)
                    {
                        <div class="nav-section-title">Tổng quan</div>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-custom @(currentCtrl == "Home" ? "active" : "")">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Tổng quan</span>
                        </a>
                        <a asp-controller="Reports" asp-action="Index" class="nav-link-custom @(currentCtrl == "Reports" ? "active" : "")">
                            <i class="bi bi-graph-up"></i>
                            <span>Báo cáo doanh thu</span>
                        </a>
                    }

                    <!-- Bán hàng -->
                    @if (canSeePos || canSeeInvoices || canSeeCustomers)
                    {
                        <div class="nav-section-title">Bán hàng</div>
                        @if (canSeePos)
                        {
                            <a asp-controller="Pos" asp-action="Index" class="nav-link-custom @(currentCtrl == "Pos" ? "active" : "")">
                                <i class="bi bi-cart3"></i>
                                <span>Bán hàng (POS)</span>
                            </a>
                        }
                        @if (canSeeInvoices)
                        {
                            <a asp-controller="Invoices" asp-action="Index" class="nav-link-custom @(currentCtrl == "Invoices" ? "active" : "")">
                                <i class="bi bi-receipt"></i>
                                <span>Hóa đơn</span>
                            </a>
                        }
                        @if (canSeeCustomers)
                        {
                            <a asp-controller="Customers" asp-action="Index" class="nav-link-custom @(currentCtrl == "Customers" ? "active" : "")">
                                <i class="bi bi-people"></i>
                                <span>Khách hàng</span>
                            </a>
                        }
                    }

                    <!-- Hàng hóa -->
                    @if (canSeeProducts || canSeePromotions || canSeeSuppliers)
                    {
                        <div class="nav-section-title">Hàng hóa</div>
                        @if (canSeeProducts)
                        {
                            <a asp-controller="Products" asp-action="Index" class="nav-link-custom @(currentCtrl == "Products" ? "active" : "")">
                                <i class="bi bi-box-seam"></i>
                                <span>Sản phẩm</span>
                            </a>
                        }
                        @if (canSeePromotions)
                        {
                            <a asp-controller="Promotions" asp-action="Index" class="nav-link-custom @(currentCtrl == "Promotions" ? "active" : "")">
                                <i class="bi bi-tag"></i>
                                <span>Khuyến mãi</span>
                            </a>
                        }
                        @if (canSeeSuppliers)
                        {
                            <a asp-controller="Suppliers" asp-action="Index" class="nav-link-custom @(currentCtrl == "Suppliers" ? "active" : "")">
                                <i class="bi bi-building"></i>
                                <span>Nhà cung cấp</span>
                            </a>
                        }
                    }

                    <!-- Kho hàng -->
                    @if (canSeeInventory || canSeeImport || canSeeTransfers)
                    {
                        <div class="nav-section-title">Kho hàng</div>
                        @if (canSeeInventory)
                        {
                            <a asp-controller="Inventory" asp-action="Index" class="nav-link-custom @(currentCtrl == "Inventory" ? "active" : "")">
                                <i class="bi bi-boxes"></i>
                                <span>Tồn kho</span>
                            </a>
                        }
                        @if (canSeeImport)
                        {
                            <a asp-controller="Import" asp-action="Index" class="nav-link-custom @(currentCtrl == "Import" ? "active" : "")">
                                <i class="bi bi-truck"></i>
                                <span>Nhập hàng</span>
                            </a>
                        }
                        @if (canSeeTransfers)
                        {
                            <a asp-controller="Transfers" asp-action="Index" class="nav-link-custom @(currentCtrl == "Transfers" ? "active" : "")">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Chuyển kho</span>
                            </a>
                        }
                    }

                    <!-- Quản trị -->
                    @if (canSeeAdmin)
                    {
                        <div class="nav-section-title">Quản trị</div>
                        <a asp-controller="Stores" asp-action="Index" class="nav-link-custom @(currentCtrl == "Stores" ? "active" : "")">
                            <i class="bi bi-shop-window"></i>
                            <span>Chi nhánh</span>
                        </a>
                        <a asp-controller="Users" asp-action="Index" class="nav-link-custom @(currentCtrl == "Users" ? "active" : "")">
                            <i class="bi bi-person-gear"></i>
                            <span>Nhân viên</span>
                        </a>
                    }
                </div>
            </aside>

            <!-- Main Area -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="topbar-page-info">
                        <h1>@(ViewData["Title"] ?? "Trang chủ")</h1>
                        <p>@currentStoreName · <span class="text-capitalize">@todayStr</span></p>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <!-- User Menu Dropdown -->
                        <div class="dropdown">
                            <button class="user-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="avatar-circle">@initials</div>
                                <div class="user-details d-none d-sm-block">
                                    <div class="user-name">@currentFullName</div>
                                    <div class="user-role-badge">@roleTitle</div>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2 p-2" style="min-width: 220px;">
                                <li class="px-3 py-2 border-bottom mb-1">
                                    <div class="fw-bold small">@currentFullName</div>
                                    <div class="text-muted" style="font-size: 11.5px;">@@@User.Identity?.Name · @roleTitle</div>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 small" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-muted"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 small text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="app-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 py-2 px-3 small mb-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 10px;"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 small mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 10px;"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
