@model List<MiniMart.Web.Models.Entities.Promotion>
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    var now = DateTime.Now;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1 text-slate-900 fw-bold">Chương trình khuyến mãi & Giảm giá</h2>
        <p class="text-muted small mb-0">Thiết lập chính sách chiết khấu %, giảm giá tiền mặt hoặc mua X tặng Y</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Tạo chương trình mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-tags"></i>
                </div>
                <div>
                    <div class="stat-label">Tổng số chương trình</div>
                    <div class="stat-value">@ViewBag.TotalCount</div>
                    <div class="small text-muted">Toàn hệ thống</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="stat-label">Đang diễn ra hiệu lực</div>
                    <div class="stat-value text-success">@ViewBag.RunningCount</div>
                    <div class="small text-muted">Đang áp dụng tại quầy POS</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="stat-label">Sắp diễn ra</div>
                    <div class="stat-value text-info">@ViewBag.UpcomingCount</div>
                    <div class="small text-muted">Chiến dịch tương lai</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control bg-light border-start-0" placeholder="Tên chương trình, mô tả..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select bg-light">
                    <option value="ALL" selected="@(ViewBag.Type == "ALL" || string.IsNullOrEmpty(ViewBag.Type))">Tất cả hình thức</option>
                    <option value="PERCENTAGE" selected="@(ViewBag.Type == "PERCENTAGE")">Giảm theo %</option>
                    <option value="FIXED_AMOUNT" selected="@(ViewBag.Type == "FIXED_AMOUNT")">Giảm số tiền cố định</option>
                    <option value="BUY_X_GET_Y" selected="@(ViewBag.Type == "BUY_X_GET_Y")">Mua X tặng Y</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select bg-light">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status))">Tất cả trạng thái</option>
                    <option value="RUNNING" selected="@(ViewBag.Status == "RUNNING")">Đang diễn ra</option>
                    <option value="UPCOMING" selected="@(ViewBag.Status == "UPCOMING")">Sắp diễn ra</option>
                    <option value="EXPIRED" selected="@(ViewBag.Status == "EXPIRED")">Đã kết thúc</option>
                    <option value="INACTIVE" selected="@(ViewBag.Status == "INACTIVE")">Đang tạm ngưng</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng khuyến mãi -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Tên chương trình</th>
                    <th>Hình thức khuyến mãi</th>
                    <th>Thời gian áp dụng</th>
                    <th class="text-center">Số sản phẩm</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-tags display-4 d-block mb-2 text-slate-300"></i>
                            Chưa có chương trình khuyến mãi nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        var isRunning = p.IsActive && p.StartDate <= now && p.EndDate >= now;
                        var isUpcoming = p.IsActive && p.StartDate > now;
                        var isExpired = p.EndDate < now;

                        <tr>
                            <td class="ps-4">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="fw-bold text-slate-900 text-decoration-none">
                                    @p.Name
                                </a>
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <div class="small text-muted" style="font-size: 11.5px;">@p.Description</div>
                                }
                            </td>
                            <td>
                                @switch (p.PromoType)
                                {
                                    case "PERCENTAGE":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-percent me-1"></i> Giảm theo %
                                        </span>
                                        break;
                                    case "FIXED_AMOUNT":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-currency-dollar me-1"></i> Giảm tiền mặt
                                        </span>
                                        break;
                                    case "BUY_X_GET_Y":
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-gift me-1"></i> Mua X tặng Y
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@p.PromoType</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="small">
                                    <span class="text-muted">Từ:</span> <strong>@p.StartDate.ToString("dd/MM/yyyy")</strong>
                                    <br>
                                    <span class="text-muted">Đến:</span> <strong>@p.EndDate.ToString("dd/MM/yyyy")</strong>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@p.PromotionItems.Count SP</span>
                            </td>
                            <td class="text-center">
                                @if (!p.IsActive)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        <i class="bi bi-pause-circle me-1"></i> Tạm ngưng
                                    </span>
                                }
                                else if (isRunning)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-play-circle me-1"></i> Đang chạy
                                    </span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        <i class="bi bi-clock me-1"></i> Sắp diễn ra
                                    </span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-light text-muted border">
                                        <i class="bi bi-stop-circle me-1"></i> Đã kết thúc
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="ToggleStatus" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="@(p.IsActive ? "Tạm ngưng" : "Kích hoạt")">
                                            <i class="bi @(p.IsActive ? "bi-pause" : "bi-play")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chương trình này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

